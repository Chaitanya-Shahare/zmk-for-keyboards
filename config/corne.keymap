#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Mouse {
            bindings = <&to 5>;
            key-positions = <19 20 21 22>;
            layers = <0>;
        };

        mouse-off {
            bindings = <&to 0>;
            key-positions = <19 20 21 22>;
            layers = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp TAB       &kp Q  &kp W  &kp E             &kp R         &kp T         &kp Y            &kp U        &kp I        &kp O    &kp P          &kp BSPC
&lt 1 ESCAPE  &kp A  &kp S  &kp D             &kp F         &kp G         &kp H            &kp J        &kp K        &kp L    &kp SEMICOLON  &kp SQT
&kp LSHFT     &kp Z  &kp X  &kp C             &kp V         &kp B         &kp N            &kp M        &kp COMMA    &kp DOT  &kp FSLH       &kp ESC
                            &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp RIGHT_SHIFT  &lt 2 SPACE  &lt 3 ENTER
            >;
        };

        nav {
            bindings = <
&none           &none         &none         &none             &none           &none         &kp C_AC_REDO    &kp C_AC_PASTE  &kp C_AC_COPY  &kp C_AC_CUT     &kp C_AC_UNDO  &kp BACKSPACE
&none           &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none         &kp LEFT_ARROW   &kp DOWN_ARROW  &kp UP_ARROW   &kp RIGHT_ARROW  &none          &kp DELETE
&kp LEFT_SHIFT  &none         &none         &none             &none           &none         &kp INSERT       &kp HOME        &kp PAGE_DOWN  &kp PAGE_UP      &kp END        &none
                                            &kp LEFT_CONTROL  &kp LEFT_ALT    &kp LEFT_GUI  &kp RIGHT_SHIFT  &kp SPACE       &kp ENTER
            >;
        };

        num {
            bindings = <
&kp GRAVE       &kp NUMBER_1      &kp NUMBER_2       &kp NUMBER_3      &kp NUMBER_4      &kp N5            &kp NUMBER_6      &kp NUMBER_7      &kp NUMBER_8      &kp NUMBER_9      &kp NUMBER_0      &kp BACKSPACE
&kp TILDE       &kp LS(NUMBER_1)  &kp LS(NUMBER_2)   &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)  &kp LS(NUMBER_6)  &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LS(NUMBER_0)  &none
&kp LEFT_SHIFT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE    &kp RIGHT_BRACE   &kp BSLH          &kp PIPE          &kp MINUS         &kp EQUAL         &kp UNDER         &kp PLUS          &none
                                                     &kp LEFT_CONTROL  &kp LEFT_ALT      &kp LEFT_GUI      &kp RIGHT_SHIFT   &none             &none
            >;
        };

        func {
            bindings = <
&none           &kp F12  &kp F7  &kp F8            &kp F9        &none         &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &rgb_ug RGB_TOG
&none           &kp F11  &kp F4  &kp F5            &kp F6        &none         &rgb_ug RGB_BRI  &kp F7           &kp F8           &kp F9           &kp RGUI         &none
&kp LEFT_SHIFT  &kp F10  &kp F1  &kp F2            &kp F3        &none         &rgb_ug RGB_BRD  &kp F11          &kp F10          &kp F12          &none            &sl 4
                                 &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &none            &none            &none
            >;
        };

        blue {
            bindings = <
&none  &none         &none         &none             &none           &none  &rgb_ug RGB_TOG    &rgb_ug RGB_EFF   &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_COLOR_HSB(275,100,50)  &none
&none  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none  &ext_power EP_TOG  &kp C_PREVIOUS    &kp C_VOL_DN     &kp C_VOL_UP     &kp C_NEXT                         &none
&none  &none         &none         &none             &none           &none  &out OUT_TOG       &bt BT_SEL 0      &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3                       &bt BT_CLR_ALL
                                   &none             &none           &none  &kp K_STOP         &kp K_PLAY_PAUSE  &kp K_MUTE
            >;
        };

        mouse {
            bindings = <
&none           &none         &none           &mmv MOVE_UP      &none            &none         &kp C_AC_REDO   &kp C_AC_COPY   &mmv MOVE_UP    &kp C_AC_PASTE   &kp C_AC_UNDO  &kp BACKSPACE
&none           &kp LEFT_GUI  &mmv MOVE_LEFT  &mmv MOVE_DOWN    &mmv MOVE_RIGHT  &none         &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &none          &none
&kp LEFT_SHIFT  &none         &none           &none             &none            &none         &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_DOWN  &msc SCRL_RIGHT  &none          &none
                                              &kp LEFT_CONTROL  &kp LEFT_ALT     &kp LEFT_GUI  &mkp RCLK       &mkp LCLK       &mkp MCLK
            >;
        };

        sym {
            bindings = <
&none  &kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE  &none  &none      &none      &none     &none     &none
&none  &kp COLON       &kp DOLLAR       &kp PERCENT           &kp CARET              &kp PLUS         &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &kp TILDE       &kp EXCLAMATION  &kp AT_SIGN           &kp HASH               &kp PIPE         &none  &none      &none      &none     &none     &none
                                        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE   &none  &none      &none
            >;
        };
    };
};
